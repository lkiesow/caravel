/bin/
/data/
/uploads/
.claude/

# Playwright/vim scratch from local UI testing. The mobile screenshots are
# throwaway dev artifacts — findings get written up in the stage plan instead of
# committing ~400K of PNGs per test round.
/plans/mobile-fresh-*.png
*.swp
.cache/
.playwright-mcp/
.dev/

# Node tooling for the Playwright UI suite (dev-only; the app ships no npm deps).
/node_modules/
/test-results/
/playwright-report/
/blob-report/

# A live session token, written fresh by tests/ui/auth.setup.js on every run.
/tests/ui/.auth/

# Live API credentials for the assistant (Stage 16). Env-var-only by design —
# see internal/config — so nothing in the repo should ever read these, and
# nothing should ever commit them. Ignored broadly rather than by exact name:
# the failure mode is silent and permanent, since a key that reaches a public
# history has to be rotated, not deleted.
/credentials.yaml
/credentials.yml
/*.credentials
/.env
/.env.*
# ...except the committed template, which holds no values -- it is the file
# somebody copies to .env, so it has to be in the repository.
!/.env.sample

# The generated documentation site (see zensical.toml). Built output, not
# sources: GitHub Pages builds it from CI, and locally it is `make docs`.
/site/

# Release archives built by scripts or .github/workflows/release.yml.
/dist/

# Cross-compiled binaries staged for packaging (see .github/workflows/release.yml).
/build/
