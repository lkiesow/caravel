# Caravel configuration. Copy this file to `.env` beside the compose file and
# edit it -- both docker-compose.yml and docker-compose.postgres.yml read it if
# it exists, and start fine when it does not.
#
#   cp .env.sample .env
#   docker compose up -d
#
# `.env` is gitignored; this sample is the only one of the two that is
# committed, so never put a real key here.
#
# Everything is commented out because every setting has a working default: a
# bare `docker compose up -d` is already a complete installation. Uncomment
# only what you actually want to change. A restart is needed after an edit
# (`docker compose up -d` re-creates the container).
#
# Full reference: https://lkiesow.github.io/caravel/configuration/server/


# ---------------------------------------------------------------------------
# Server and database
# ---------------------------------------------------------------------------

# HTTP listen port inside the container. Changing which port the *host*
# publishes is the `ports:` mapping in the compose file, not this.
#CARAVEL_PORT=8080

# `sqlite` (default) or `postgres`. Anything else is refused at startup.
#
# There is no migration path between the two dialects -- Caravel will create
# its schema in either, but nothing moves data across. Choose before putting
# real trips in it.
#CARAVEL_DB_DRIVER=sqlite

# SQLite file path, or a Postgres connection string. The compose files already
# set this to /data/caravel.db, which is where the volume is mounted, so only
# override it if you are also changing the volume.
#CARAVEL_DB_DSN=/data/caravel.db
#CARAVEL_DB_DSN=postgres://caravel:password@db:5432/caravel?sslmode=disable

# Where uploaded images and documents are stored. Files on disk, never blobs in
# the database -- so this directory and the database have to be backed up
# together, or the restore has rows pointing at pictures that are gone.
#CARAVEL_UPLOAD_DIR=/uploads


# ---------------------------------------------------------------------------
# Address search
# ---------------------------------------------------------------------------

# The upstream endpoint the /api/geocode proxy calls, called from the server
# rather than the browser. Defaults to OpenStreetMap's Nominatim; point it at
# your own instance if you run one, or set it empty to switch address search
# off entirely (the client then hides the control rather than offering one that
# cannot work).
#CARAVEL_GEOCODER_URL=https://nominatim.openstreetmap.org/search


# ---------------------------------------------------------------------------
# The AI assistant -- optional, off unless CARAVEL_LLM_URL is set
# ---------------------------------------------------------------------------

# An OpenAI-compatible endpoint: either the base URL the provider documents or
# the full /chat/completions path. URL and model are both required to enable
# the assistant; setting one without the other is refused at startup.
#CARAVEL_LLM_URL=https://openrouter.ai/api/v1
#CARAVEL_LLM_MODEL=
# Bearer token. Omit for a local Ollama or llama.cpp that needs none.
#CARAVEL_LLM_KEY=

# Web search for the assistant. Optional, but without it the assistant has only
# OpenStreetMap and whatever the model already knows. One of: ollama, serper
# (both hosted, need CARAVEL_SEARCH_KEY), ddgs (yours to run, needs
# CARAVEL_SEARCH_URL). Setting this without CARAVEL_LLM_URL is refused at
# startup: nothing else in the app searches the web.
#CARAVEL_SEARCH_PROVIDER=
#CARAVEL_SEARCH_KEY=
# Only for the self-hosted providers; the hosted ones ignore it.
#CARAVEL_SEARCH_URL=

# Guard rails on the assistant. The first six bound one run; the last two bound
# the instance, and are what actually caps a bill. Defaults shown.
#CARAVEL_ASSIST_MAX_TOKENS=120000
#CARAVEL_ASSIST_ANSWER_RESERVE=20000
#CARAVEL_ASSIST_MAX_TURNS=12
#CARAVEL_ASSIST_MAX_TOOL_CALLS=20
#CARAVEL_ASSIST_TIMEOUT=90s
#CARAVEL_ASSIST_ANSWER_TIMEOUT=2m
#CARAVEL_ASSIST_RATE_LIMIT=6
#CARAVEL_ASSIST_MAX_CONCURRENT=4


# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Serve the frontend live from this directory instead of the copy embedded in
# the binary. `make dev` sets it; a deployment has no reason to.
#CARAVEL_WEB_DIR=web
