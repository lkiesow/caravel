# Caravel configuration. Copy this file to `.env` beside the compose file and
# edit it -- both docker-compose.yml and docker-compose.postgres.yml read it if
# it exists, and start fine when it does not.
#
#   cp .env.sample .env
#   docker compose up -d
#
# `.env` is gitignored; this sample is the only one of the two that is
# committed, so never put a real key here.
#
# Everything is commented out because every setting has a working default: a
# bare `docker compose up -d` is already a complete installation. Uncomment
# only what you actually want to change. A restart is needed after an edit
# (`docker compose up -d` re-creates the container).
#
# Full reference: https://lkiesow.github.io/caravel/configuration/server/


# ---------------------------------------------------------------------------
# Server and database
# ---------------------------------------------------------------------------

# HTTP listen port inside the container. Changing which port the *host*
# publishes is the `ports:` mapping in the compose file, not this.
#CARAVEL_PORT=8080

# How much the server says, and how. One of debug, info (default), warn,
# error; anything else is refused at startup rather than quietly ignored.
#
# `debug` is what makes the AI assistant explain itself: every turn with its
# wall time and token usage, every search and page read with how long it took,
# why the run stopped and what it kept or dropped. That is the answer to "why
# was that so slow". It is verbose and it is per-run, so it is not a level to
# leave on -- but nothing above debug is emitted for an ordinary run at all,
# so turning it on and off costs nothing either.
#CARAVEL_LOG_LEVEL=info

# `text` (default) or `json`. Text is one readable line per record, which is
# what you want in `docker logs` or journalctl. Use json if you ship the log
# somewhere that parses it.
#CARAVEL_LOG_FORMAT=text

# `sqlite` (default) or `postgres`. Anything else is refused at startup.
#
# There is no migration path between the two dialects -- Caravel will create
# its schema in either, but nothing moves data across. Choose before putting
# real trips in it.
#CARAVEL_DB_DRIVER=sqlite

# SQLite file path, or a Postgres connection string. The compose files already
# set this to /data/caravel.db, which is where the volume is mounted, so only
# override it if you are also changing the volume.
#CARAVEL_DB_DSN=/data/caravel.db
#CARAVEL_DB_DSN=postgres://caravel:password@db:5432/caravel?sslmode=disable

# Where uploaded images and documents are stored. Files on disk, never blobs in
# the database -- so this directory and the database have to be backed up
# together, or the restore has rows pointing at pictures that are gone.
#CARAVEL_UPLOAD_DIR=/uploads


# ---------------------------------------------------------------------------
# Map style
# ---------------------------------------------------------------------------

# The vector map style the browser draws. The default is served by Caravel
# itself, with map data from OpenFreeMap -- no key, nothing to sign up for.
#
# You probably do not need to change this. The raster tile settings this
# replaced existed because pre-rendered tiles label places in the local script
# and no setting could change it; the map is drawn in the browser now, so
# labels follow each reader's own language automatically. What is left is
# choosing who serves your map data: your own tile server, or a commercial
# provider.
#
# Note the style's requests go straight from each reader's browser to whoever
# serves them, so this points your users at whoever you name here. Attribution
# comes from the style itself and needs no variable.
#
# Two of them because light and dark are a per-reader preference. Setting only
# the light one uses that style for both, which is deliberate: a style has no
# obligation to have a dark counterpart.
#
# https://lkiesow.github.io/caravel/configuration/map-style/
#CARAVEL_MAP_STYLE_URL=/js/vendor/map-styles/liberty.json
#CARAVEL_MAP_STYLE_DARK_URL=/js/vendor/map-styles/dark.json

# Self-hosted, via OpenFreeMap's own instructions or TileServer GL.
#CARAVEL_MAP_STYLE_URL=https://tiles.example.org/styles/liberty.json
#CARAVEL_MAP_STYLE_DARK_URL=https://tiles.example.org/styles/dark.json


# ---------------------------------------------------------------------------
# Address search
# ---------------------------------------------------------------------------

# The upstream endpoint the /api/geocode proxy calls, called from the server
# rather than the browser. Defaults to OpenStreetMap's Nominatim; point it at
# your own instance if you run one, or set it empty to switch address search
# off entirely (the client then hides the control rather than offering one that
# cannot work).
#CARAVEL_GEOCODER_URL=https://nominatim.openstreetmap.org/search


# ---------------------------------------------------------------------------
# The AI assistant -- optional, off unless CARAVEL_LLM_URL is set
# ---------------------------------------------------------------------------

# An OpenAI-compatible endpoint: either the base URL the provider documents or
# the full /chat/completions path. URL and model are both required to enable
# the assistant; setting one without the other is refused at startup.
#CARAVEL_LLM_URL=https://openrouter.ai/api/v1
#CARAVEL_LLM_MODEL=
# Bearer token. Omit for a local Ollama or llama.cpp that needs none.
#CARAVEL_LLM_KEY=

# Web search for the assistant. Optional, but without it the assistant has only
# OpenStreetMap and whatever the model already knows. One of: ollama, serper
# (both hosted, need CARAVEL_SEARCH_KEY), ddgs (yours to run, needs
# CARAVEL_SEARCH_URL). Since Stage 21 this may also be set without
# CARAVEL_LLM_URL: the "Search for an image" control in the location editor
# uses the same backend and has no assistant in it. It used to be refused at
# startup, back when nothing else in the app searched the web.
#CARAVEL_SEARCH_PROVIDER=
#CARAVEL_SEARCH_KEY=
# Only for the self-hosted providers; the hosted ones ignore it.
#CARAVEL_SEARCH_URL=

# Wikipedia API endpoint for the image picker and the assistant cover fallback.
# Leave empty: each lookup then goes to the Wikipedia edition matching the
# user language, which needs no key and no account. Set it only to pin a
# mirror.
#CARAVEL_WIKIMEDIA_URL=

# Guard rails on the assistant. The first six bound one run; the last two bound
# the instance, and are what actually caps a bill. Defaults shown.
#CARAVEL_ASSIST_MAX_TOKENS=120000
#CARAVEL_ASSIST_ANSWER_RESERVE=20000
#CARAVEL_ASSIST_MAX_TURNS=12
#CARAVEL_ASSIST_MAX_TOOL_CALLS=20
#CARAVEL_ASSIST_TIMEOUT=90s
#CARAVEL_ASSIST_ANSWER_TIMEOUT=2m
#CARAVEL_ASSIST_RATE_LIMIT=6
#CARAVEL_ASSIST_MAX_CONCURRENT=4

# Whose X-Forwarded-For header is believed, deciding which address the rate
# limiters count a request against. Defaults to the private ranges, so a proxy
# on this host or your LAN needs nothing here. Set it when your proxy is at a
# public address, or to "none" to trust no header at all. Replaces the default
# rather than adding to it.
#CARAVEL_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16


# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Serve the frontend live from this directory instead of the copy embedded in
# the binary. `make dev` sets it; a deployment has no reason to.
#CARAVEL_WEB_DIR=web
